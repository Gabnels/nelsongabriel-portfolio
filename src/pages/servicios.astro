---
import MainLayout from "../layouts/MainLayout.astro";

import {
  MapPinned,
  MonitorSmartphone,
  Search,
  ChartNoAxesCombined,
  TrendingUp,
  Wrench,
} from "@lucide/astro";
---

<MainLayout title="Servicios | Nelson Gabriel">
  <section class="py-28">
    <!-- HERO -->
    <div class="max-w-4xl mx-auto text-center mb-20">
      <span
        class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6"
      >
        Estrategias digitales que generan clientes
      </span>

      <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
        Servicios diseñados para hacer <span class="text-[var(--color-primary)]"
          >crecer</span
        > tu negocio
      </h1>

      <p class="text-neutral-400 text-lg md:text-xl leading-relaxed">
        SEO local, diseño web, tráfico orgánico y optimización para convertir
        visitas en oportunidades reales.
      </p>
    </div>

    <!-- TECH STRIP (CORREGIDO Y SEPARADO) -->
    <div class="max-w-6xl mx-auto mb-32 px-4">
      <div
        class="relative overflow-hidden rounded-[2rem]
           border border-white/10
           bg-gradient-to-b from-white/[0.07] to-white/[0.03]
           backdrop-blur-xl
           px-6 md:px-10 py-10 md:py-14"
      >
        <!-- GLOW -->
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.08),transparent_60%)]"
        >
        </div>

        <!-- HEADER -->
        <div class="relative text-center mb-12">
          <p
            class="text-xs md:text-sm uppercase tracking-[0.25em]
               text-[var(--color-primary)]
               font-semibold mb-4"
          >
            Tecnología moderna
          </p>

          <h2 class="text-2xl md:text-3xl font-bold mb-4">
            Optimizado para performance,
            <span class="text-[var(--color-primary)]">SEO</span>
            y escalabilidad
          </h2>

          <p
            class="text-neutral-400 max-w-2xl mx-auto
               leading-relaxed text-sm md:text-base"
          >
            Stack moderno enfocado en velocidad, experiencia de usuario,
            posicionamiento y arquitectura escalable.
          </p>
        </div>

        <!-- LOGOS MARQUEE (CORREGIDO: ELIMINADAS LAS TRIPLES COMILLAS) -->
        <div class="relative overflow-hidden">
          <div class="marquee-track">
            <!-- PRIMERA VUELTA -->
            <div class="marquee-group">
              <img src="/logos/astro.svg" alt="Astro" />
              <img src="/logos/react.svg" alt="React" />
              <img src="/logos/tailwind.svg" alt="Tailwind" />
              <img src="/logos/typescript.svg" alt="TypeScript" />
              <img src="/logos/lighthouse.svg" alt="Lighthouse" />
              <img src="/logos/google.svg" alt="Google" />
              <img src="/logos/analytics.svg" alt="Analytics" />
              <img src="/logos/search-console.svg" alt="Search Console" />
              <img src="/logos/figma.svg" alt="Figma" />
              <img src="/logos/vercel.svg" alt="Vercel" />
            </div>

            <!-- DUPLICADO PARA LOOP -->
            <div class="marquee-group">
              <img src="/logos/astro.svg" alt="Astro" />
              <img src="/logos/react.svg" alt="React" />
              <img src="/logos/tailwind.svg" alt="Tailwind" />
              <img src="/logos/typescript.svg" alt="TypeScript" />
              <img src="/logos/lighthouse.svg" alt="Lighthouse" />
              <img src="/logos/google.svg" alt="Google" />
              <img src="/logos/analytics.svg" alt="Analytics" />
              <img src="/logos/search-console.svg" alt="Search Console" />
              <img src="/logos/figma.svg" alt="Figma" />
              <img src="/logos/vercel.svg" alt="Vercel" />
            </div>
          </div>
        </div>

        <style>
          .marquee-track {
            display: flex;
            width: max-content;
            animation: marquee 30s linear infinite;
          }

          .marquee-group {
            display: flex;
            align-items: center;
            gap: 4rem;
            padding-right: 4rem;
          }

          .marquee-group img {
            height: 40px;
            width: auto;
            opacity: 0.75;
            transition: all 0.3s ease;
            filter: grayscale(100%);
          }

          .marquee-group img:hover {
            opacity: 1;
            filter: grayscale(0%);
          }

          @keyframes marquee {
            from {
              transform: translateX(0);
            }

            to {
              transform: translateX(-50%);
            }
          }

          @media (max-width: 768px) {
            .marquee-group {
              gap: 2.5rem;
            }

            .marquee-group img {
              height: 32px;
            }
          }
        </style>
      </div>
    </div>

    <!-- PERFORMANCE & RESULTADOS (SEPARADO DE TECH STRIP POR EL MARGEN SUPERIOR) -->
    <div class="max-w-7xl mx-auto px-4 mb-28">
      <!-- HEADER -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span
          class="inline-block px-4 py-2 rounded-full
  bg-[var(--color-primary)]/10
  text-[var(--color-primary)]
  text-sm font-medium mb-6"
        >
          Rendimiento que genera resultados
        </span>

        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Una web rápida no es un lujo.
          <span class="text-[var(--color-primary)]">
            Es una ventaja competitiva.
          </span>
        </h2>

        <p class="text-neutral-400 text-lg leading-relaxed">
          Cada proyecto está optimizado para mejorar la experiencia del usuario,
          aumentar conversiones y facilitar el posicionamiento en Google.
        </p>
      </div>

      <!-- GRID -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">Velocidad optimizada</p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Carga rápida
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Menos esperas significa más usuarios permaneciendo en el sitio y
              más oportunidades de conversión.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">Experiencia de usuario</p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Más conversiones
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Estructuras enfocadas en guiar al visitante hacia llamadas,
              mensajes, reservas o solicitudes de presupuesto.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">
              SEO preparado desde el inicio
            </p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Más visibilidad
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Arquitectura optimizada para que Google pueda entender, rastrear e
              indexar correctamente cada página.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">Adaptabilidad total</p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Mobile First
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Diseños optimizados para móviles, tablets y escritorio desde el
              primer momento.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">Tecnología moderna</p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Escalable
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Infraestructura preparada para crecer junto al negocio sin
              necesidad de reconstruir el proyecto.
            </p>
          </div>
        </div>

        <!-- CARD -->
        <div
          class="group relative overflow-hidden rounded-3xl
  border border-white/10
  bg-gradient-to-b from-white/[0.05] to-white/[0.02]
  backdrop-blur-xl
  p-8
  hover:border-[var(--color-primary)]/30
  transition duration-300"
        >
          <div
            class="absolute inset-0 opacity-0 group-hover:opacity-100
    bg-[radial-gradient(circle_at_top,rgba(34,197,94,0.12),transparent_70%)]
    transition duration-500"
          >
          </div>

          <div class="relative">
            <p class="text-sm text-neutral-400 mb-3">Optimización continua</p>

            <h3 class="text-4xl font-black text-[var(--color-primary)] mb-4">
              Preparado para crecer
            </h3>

            <p class="text-neutral-400 leading-relaxed">
              Una base sólida para implementar SEO local, contenido, campañas y
              futuras estrategias de crecimiento.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- SERVICIOS -->
    <div class="max-w-7xl mx-auto mt-10">
      <!-- HEADER -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span
          class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6"
        >
          Servicios principales
        </span>

        <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          Soluciones enfocadas en generar
          <span class="text-[var(--color-primary)]">
            más clientes y crecimiento real
          </span>
        </h2>

        <p class="text-neutral-400 text-lg leading-relaxed">
          Desarrollo web, posicionamiento local y optimización estratégica para
          negocios que buscan crecer con una presencia digital profesional y
          orientada a resultados.
        </p>
      </div>

      <!-- GRID -->
      <div class="grid md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <!-- DESARROLLO WEB -->
        <a
          href="/#contacto"
          class="group relative overflow-hidden p-10 rounded-3xl bg-neutral-900/70 border border-neutral-800 hover:border-[var(--color-primary)] transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition duration-500"
          >
          </div>

          <div class="relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-8"
            >
              <MonitorSmartphone class="w-8 h-8 text-[var(--color-primary)]" />
            </div>

            <h3 class="text-3xl font-bold mb-5">Desarrollo Web Premium</h3>

            <p class="text-neutral-400 leading-relaxed text-lg">
              Sitios web rápidos, modernos y optimizados para convertir
              visitantes en contactos, reservas o ventas. Diseñados para
              transmitir confianza y generar una experiencia profesional en
              cualquier dispositivo.
            </p>
          </div>
        </a>

        <!-- SEO LOCAL -->
        <a
          href="/#contacto"
          class="group relative overflow-hidden p-10 rounded-3xl bg-neutral-900/70 border border-neutral-800 hover:border-[var(--color-primary)] transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition duration-500"
          >
          </div>

          <div class="relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-8"
            >
              <MapPinned class="w-8 h-8 text-[var(--color-primary)]" />
            </div>

            <h3 class="text-3xl font-bold mb-5">
              SEO Local y Google Business Profile
            </h3>

            <p class="text-neutral-400 leading-relaxed text-lg">
              Optimización estratégica para mejorar la visibilidad de tu negocio
              en Google Maps y aparecer cuando los clientes buscan servicios en
              tu ciudad o área de cobertura.
            </p>
          </div>
        </a>

        <!-- OPTIMIZACION -->
        <a
          href="/#contacto"
          class="group relative overflow-hidden p-10 rounded-3xl bg-neutral-900/70 border border-neutral-800 hover:border-[var(--color-primary)] transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition duration-500"
          >
          </div>

          <div class="relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-8"
            >
              <Search class="w-8 h-8 text-[var(--color-primary)]" />
            </div>

            <h3 class="text-3xl font-bold mb-5">
              Optimización Web y SEO Técnico
            </h3>

            <p class="text-neutral-400 leading-relaxed text-lg">
              Mejoras de rendimiento, experiencia de usuario, indexación y
              arquitectura SEO para que tu sitio cargue más rápido y tenga
              mejores oportunidades de posicionamiento.
            </p>
          </div>
        </a>

        <!-- MANTENIMIENTO -->
        <a
          href="/#contacto"
          class="group relative overflow-hidden p-10 rounded-3xl bg-neutral-900/70 border border-neutral-800 hover:border-[var(--color-primary)] transition-all duration-300 hover:-translate-y-2"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition duration-500"
          >
          </div>

          <div class="relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-8"
            >
              <Wrench class="w-8 h-8 text-[var(--color-primary)]" />
            </div>

            <h3 class="text-3xl font-bold mb-5">Mantenimiento y Soporte</h3>

            <p class="text-neutral-400 leading-relaxed text-lg">
              Actualizaciones, monitoreo y mejoras continuas para mantener tu
              sitio seguro, rápido y funcionando correctamente mientras te
              enfocas en tu negocio.
            </p>
          </div>
        </a>
      </div>
    </div>

    <!-- PROCESO PREMIUM -->
    <div class="max-w-7xl mx-auto mt-32">
      <!-- HEADER -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <span
          class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6"
        >
          Metodología de trabajo
        </span>

        <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          Un proceso diseñado para
          <span class="text-[var(--color-primary)]"> generar resultados </span>
        </h2>

        <p class="text-neutral-400 text-lg leading-relaxed">
          Cada proyecto sigue una metodología clara y estructurada enfocada en
          posicionamiento, experiencia de usuario y generación de oportunidades
          de negocio.
        </p>
      </div>

      <!-- PROCESS GRID -->
      <div class="relative">
        <!-- LINE -->
        <div
          class="hidden lg:block absolute top-1/2 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--color-primary)]/20 to-transparent"
        >
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
          <!-- STEP 1 -->
          <div
            class="group relative rounded-3xl border border-white/10 bg-neutral-900/80 backdrop-blur-md p-8 hover:border-[var(--color-primary)]/40 transition duration-500 hover:-translate-y-2"
          >
            <div
              class="absolute inset-0 rounded-3xl bg-[var(--color-primary)]/5 opacity-0 group-hover:opacity-100 transition duration-500"
            >
            </div>

            <div class="relative z-10">
              <div
                class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] font-black text-lg mb-8"
              >
                01
              </div>

              <h3 class="text-2xl font-bold mb-4">
                Descubrimiento del negocio
              </h3>

              <p class="text-neutral-400 leading-relaxed">
                Analizo objetivos, servicios, competencia y oportunidades para
                construir una estrategia alineada al crecimiento del negocio.
              </p>
            </div>
          </div>

          <!-- STEP 2 -->
          <div
            class="group relative rounded-3xl border border-white/10 bg-neutral-900/80 backdrop-blur-md p-8 hover:border-[var(--color-primary)]/40 transition duration-500 hover:-translate-y-2"
          >
            <div
              class="absolute inset-0 rounded-3xl bg-[var(--color-primary)]/5 opacity-0 group-hover:opacity-100 transition duration-500"
            >
            </div>

            <div class="relative z-10">
              <div
                class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] font-black text-lg mb-8"
              >
                02
              </div>

              <h3 class="text-2xl font-bold mb-4">Planificación estratégica</h3>

              <p class="text-neutral-400 leading-relaxed">
                Defino la estructura del sitio, experiencia de usuario, SEO
                local y arquitectura necesaria para alcanzar los objetivos del
                proyecto.
              </p>
            </div>
          </div>

          <!-- STEP 3 -->
          <div
            class="group relative rounded-3xl border border-white/10 bg-neutral-900/80 backdrop-blur-md p-8 hover:border-[var(--color-primary)]/40 transition duration-500 hover:-translate-y-2"
          >
            <div
              class="absolute inset-0 rounded-3xl bg-[var(--color-primary)]/5 opacity-0 group-hover:opacity-100 transition duration-500"
            >
            </div>

            <div class="relative z-10">
              <div
                class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] font-black text-lg mb-8"
              >
                03
              </div>

              <h3 class="text-2xl font-bold mb-4">Diseño y desarrollo</h3>

              <p class="text-neutral-400 leading-relaxed">
                Construyo una experiencia moderna, rápida y optimizada para
                generar confianza, credibilidad y conversiones.
              </p>
            </div>
          </div>

          <!-- STEP 4 -->
          <div
            class="group relative rounded-3xl border border-white/10 bg-neutral-900/80 backdrop-blur-md p-8 hover:border-[var(--color-primary)]/40 transition duration-500 hover:-translate-y-2"
          >
            <div
              class="absolute inset-0 rounded-3xl bg-[var(--color-primary)]/5 opacity-0 group-hover:opacity-100 transition duration-500"
            >
            </div>

            <div class="relative z-10">
              <div
                class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center text-[var(--color-primary)] font-black text-lg mb-8"
              >
                04
              </div>

              <h3 class="text-2xl font-bold mb-4">
                Lanzamiento y optimización
              </h3>

              <p class="text-neutral-400 leading-relaxed">
                Publico el proyecto, configuro herramientas de medición y
                realizo optimizaciones iniciales para maximizar resultados.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- TRUST BAR -->
      <div
        class="mt-14 rounded-3xl border border-white/10 bg-neutral-900/60 p-8 text-center"
      >
        <p class="text-neutral-300 text-lg leading-relaxed max-w-4xl mx-auto">
          Cada proyecto se desarrolla con enfoque en
          <span class="text-[var(--color-primary)] font-semibold">
            posicionamiento, velocidad, experiencia de usuario y conversión
          </span>, evitando soluciones genéricas y priorizando resultados
          sostenibles a largo plazo.
        </p>
      </div>
    </div>

    <!-- PACKAGES -->
    <div class="max-w-7xl mx-auto mt-32">
      <!-- HEADER -->
      <div class="text-center max-w-4xl mx-auto mb-16">
        <span
          class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6"
        >
          Inversión y servicios
        </span>

        <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Planes diseñados para diferentes
          <span class="text-[var(--color-primary)]">
            etapas de crecimiento
          </span>
        </h2>

        <p class="text-neutral-400 text-lg leading-relaxed">
          Soluciones orientadas a negocios que buscan una presencia digital
          profesional, mayor visibilidad y más oportunidades de venta.
        </p>
      </div>

      <!-- GRID -->
      <div class="grid lg:grid-cols-3 gap-8 items-stretch">
        <!-- PLAN 1 -->
        <div
          class="rounded-3xl border border-neutral-800 bg-neutral-900/70 p-8 flex flex-col"
        >
          <div class="mb-8">
            <p class="text-sm text-neutral-400 mb-3 uppercase tracking-wider">
              Starter
            </p>

