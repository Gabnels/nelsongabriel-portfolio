---
import MainLayout from "../../layouts/MainLayout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<MainLayout title={project.seo?.title || project.title}>
  <section class="py-28 max-w-4xl mx-auto px-4">
    <!-- IMAGEN + BADGE -->
    <div class="relative mb-10">
      <img
        src={project.image}
        alt={project.title}
        class="w-full h-[400px] object-cover rounded-2xl"
      />

      <!-- BADGE RESULTADO -->
      <div
        class="absolute bottom-4 right-4 bg-[var(--color-primary)] text-black px-4 py-2 rounded-lg font-bold shadow-lg"
      >
        {project.result}
      </div>
    </div>

    <!-- TITULO -->
    <h1 class="text-4xl font-bold mb-4">
      {project.title}
    </h1>

    <p class="text-neutral-400 mb-10">
      {project.description}
    </p>

    <!-- BEFORE / AFTER VISUAL -->
    {
      project.beforeImage && project.afterImage && (
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="relative">
            <img
              src={project.beforeImage}
              alt="Antes del proyecto"
              class="w-full h-[260px] object-cover rounded-xl border border-neutral-800"
            />
            <span class="absolute top-3 left-3 bg-red-500 text-white text-xs px-3 py-1 rounded-full">
              Antes
            </span>
          </div>

          <div class="relative">
            <img
              src={project.afterImage}
              alt="Después del proyecto"
              class="w-full h-[260px] object-cover rounded-xl border border-neutral-800"
            />
            <span class="absolute top-3 left-3 bg-green-500 text-black text-xs px-3 py-1 rounded-full">
              Después
            </span>
          </div>
        </div>
      )
    }

    <!-- METRICS -->
    <div class="grid grid-cols-3 gap-4 mb-16">
      {
        project.metrics.map((m) => (
          <div class="bg-neutral-900 border border-neutral-800 p-4 rounded-xl text-center">
            <p class="text-[var(--color-primary)] font-bold text-xl">
              {m.value}
            </p>
            <p class="text-sm text-neutral-400">{m.label}</p>
          </div>
        ))
      }
    </div>

    <!-- BEFORE / AFTER TEXTO -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <div
        data-aos="fade-up"
        class="p-6 rounded-xl bg-neutral-900 border border-neutral-800"
      >
        <h3 class="text-red-400 font-semibold mb-3">Antes</h3>
        <p class="text-neutral-300 whitespace-pre-line">
          {project.before}
        </p>
      </div>

      <div
        data-aos="fade-up"
        data-aos-delay="100"
        class="p-6 rounded-xl bg-neutral-900 border border-neutral-800"
      >
        <h3 class="text-green-400 font-semibold mb-3">Después</h3>
        <p class="text-neutral-300 whitespace-pre-line">
          {project.after}
        </p>
      </div>
    </div>

    <!-- PROBLEMA -->
    <div data-aos="fade-up" class="mb-10">
      <h2 class="text-2xl font-semibold mb-3 text-red-400">Problema</h2>
      <p class="text-neutral-300 whitespace-pre-line">
        {project.problem}
      </p>
    </div>

    <!-- SOLUCIÓN -->
    <div data-aos="fade-up" data-aos-delay="100" class="mb-10">
      <h2 class="text-2xl font-semibold mb-3 text-yellow-400">Solución</h2>
      <p class="text-neutral-300 whitespace-pre-line">
        {project.solution}
      </p>
    </div>

    <!-- PROCESO -->
    {
      project.process && (
        <div data-aos="fade-up" class="mb-16">
          <h2 class="text-2xl font-semibold mb-8 text-blue-400">
            Proceso de desarrollo
          </h2>

          <div class="space-y-6">
            {project.process.map((step, index) => (
              <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="flex items-center gap-4 mb-3">
                  <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] text-black font-bold flex items-center justify-center">
                    {index + 1}
                  </div>

                  <h3 class="font-semibold text-lg">{step.title}</h3>
                </div>

                <p class="text-neutral-400">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <!-- RESULTADOS -->
    <div data-aos="fade-up" data-aos-delay="200" class="mb-16">
      <h2 class="text-2xl font-semibold mb-3 text-green-400">Resultados</h2>
      <p class="text-neutral-300 whitespace-pre-line">
        {project.outcome}
      </p>
    </div>

    <!-- HERRAMIENTAS -->
    {
      project.tools && (
        <div data-aos="fade-up" class="mb-16">
          <h2 class="text-2xl font-semibold mb-6 text-[var(--color-primary)]">
            Herramientas utilizadas
          </h2>

          <div class="flex flex-wrap gap-3">
            {project.tools.map((tool) => (
              <span
                class="
            px-4
            py-2
            rounded-full
            border
            border-neutral-700
            bg-neutral-900
            text-neutral-300
            text-sm
            hover:border-[var(--color-primary)]
            hover:text-[var(--color-primary)]
            transition
          "
              >
                {tool}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- TESTIMONIO -->
    {
      project.testimonial && (
        <div
          data-aos="fade-up"
          class="mb-16 p-6 rounded-xl bg-neutral-900 border border-neutral-800"
        >
          <p class="text-neutral-300 italic mb-4">
            “{project.testimonial.text}”
          </p>
          <p class="text-sm text-neutral-500">— {project.testimonial.author}</p>
        </div>
      )
    }

    <!-- CTA FINAL PRO -->
    {
      project.cta && (
        <div
          data-aos="fade-up"
          class="mt-20 p-10 rounded-2xl bg-gradient-to-r from-neutral-900 to-neutral-800 border border-neutral-700 text-center"
        >
          <h3 class="text-2xl font-bold mb-4">
            ¿Quieres resultados como este en tu negocio?
          </h3>

          <p class="text-neutral-400 mb-6">
            Te muestro exactamente qué hacer para lograrlo.
          </p>

          <a
            href={project.cta.link}
            class="inline-block bg-[var(--color-primary)] text-black px-8 py-4 rounded-xl font-semibold text-lg hover:scale-105 transition"
          >
            {project.cta.text}
          </a>
        </div>
      )
    }
  </section>
</MainLayout>
