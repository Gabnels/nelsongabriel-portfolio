---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const latestPosts = posts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<section data-aos="fade-up" class="pt-10 pb-28">

  <!-- HEADER -->
  <div class="text-center mb-16">

    <span class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-5">
      Blog SEO
    </span>

    <h2 class="text-4xl md:text-5xl font-bold mb-6">
      Últimos
      <span class="text-[var(--color-primary)]"> artículos</span>
    </h2>

    <p class="text-neutral-400 max-w-2xl mx-auto text-lg leading-relaxed">
      Estrategias, SEO local, posicionamiento y optimización web para atraer más clientes desde Google.
    </p>

  </div>

  <!-- GRID -->
  <div class="grid md:grid-cols-3 gap-8">

    {latestPosts.map((post, index) => (

      <a
        href={`/blog/${post.id}`}
        data-aos="fade-up"
        data-aos-delay={index * 100}
        class="group rounded-3xl overflow-hidden bg-neutral-900/70 border border-neutral-800
               hover:border-[var(--color-primary)] transition duration-300
               hover:shadow-[0_0_40px_rgba(34,197,94,0.10)]"
      >

        <!-- IMAGE -->
        <div class="overflow-hidden">

          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-56 object-cover group-hover:scale-110 transition duration-700"
          />

        </div>

        <!-- CONTENT -->
        <div class="p-7">

          <span class="inline-block text-xs font-semibold tracking-wide uppercase
                       text-[var(--color-primary)] bg-[var(--color-primary)]/10
                       px-3 py-1 rounded-full mb-4">
            {post.data.category}
          </span>

          <h3 class="text-xl font-bold leading-snug mb-4 group-hover:text-white transition">
            {post.data.title}
          </h3>

          <p class="text-neutral-400 leading-relaxed mb-6">
            {post.data.excerpt}
          </p>

          <div class="flex items-center justify-between text-sm text-neutral-500">

            <span>
              {post.data.date.toLocaleDateString("es-ES", {
                year: "numeric",
                month: "short",
                day: "numeric"
              })}
            </span>

            <span class="text-[var(--color-primary)] font-medium group-hover:translate-x-1 transition">
              Leer más →
            </span>

          </div>

        </div>

      </a>

    ))}

  </div>

  <!-- CTA -->
  <div class="text-center mt-14">

    <a
      href="/blog"
      class="inline-block bg-[var(--color-primary)] text-black px-8 py-4 rounded-2xl
             font-semibold hover:scale-105 transition duration-300"
    >
      Ver todos los artículos
    </a>

  </div>

</section>