---
import {
  MonitorSmartphone,
  Search,
  MapPinned,
  FileText,
  ArrowUpRight,
} from "@lucide/astro";
---

<section
  data-aos="fade-up"
  class="py-28 bg-neutral-900/40 rounded-3xl border border-white/5 px-6 md:px-10"
>
  <!-- HEADER -->
  <div class="text-center max-w-3xl mx-auto mb-20">
    <span
      class="inline-block px-4 py-2 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-sm font-medium mb-6"
    >
      ¿Qué necesitas?
    </span>

    <h2 class="text-4xl md:text-5xl font-bold mb-6">
      Soluciones pensadas para
      <span class="text-[var(--color-primary)]">vender más</span>
    </h2>

    <p class="text-neutral-400 text-lg leading-relaxed">
      Deja de preocuparte por la tecnología. Aquí tienes estrategias directas
      que convierten visitantes en clientes que llaman y reservan.
    </p>
  </div>

  <!-- GRID -->
  <div class="grid md:grid-cols-2 gap-8">
    <!-- CARD 1: Atrae clientes con tu web -->
    <a
      href="/servicios"
      data-aos="fade-up"
      data-aos-delay="100"
      class="group relative overflow-hidden p-8 rounded-3xl
             bg-gradient-to-b from-neutral-900 to-neutral-950
             border border-neutral-800
             hover:border-[var(--color-primary)]
             transition duration-300
             hover:-translate-y-1
             hover:shadow-[0_0_40px_rgba(34,197,94,0.12)]"
    >
      <div
        class="mb-6 inline-flex p-4 rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
      >
        <MonitorSmartphone size={32} />
      </div>

      <h3 class="text-2xl font-semibold mb-4">Atrae clientes con tu web</h3>

      <p class="text-neutral-400 leading-relaxed mb-8">
        Nada de páginas lentas o complicadas. Diseño moderno y ultrarrápido
        enfocado en que el visitante te llame, te escriba o te reserve.
      </p>

      <div
        class="flex items-center gap-2 text-[var(--color-primary)] font-medium"
      >
        Quiero una web que venda
        <ArrowUpRight
          size={18}
          class="group-hover:translate-x-1 group-hover:-translate-y-1 transition"
        />
      </div>
    </a>

    <!-- CARD 2: Aparece en Google -->
    <a
      href="/servicios"
      data-aos="fade-up"
      data-aos-delay="200"
      class="group relative overflow-hidden p-8 rounded-3xl
             bg-gradient-to-b from-neutral-900 to-neutral-950
             border border-neutral-800
             hover:border-[var(--color-primary)]
             transition duration-300
             hover:-translate-y-1
             hover:shadow-[0_0_40px_rgba(34,197,94,0.12)]"
    >
      <div
        class="mb-6 inline-flex p-4 rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
      >
        <Search size={32} />
      </div>

      <h3 class="text-2xl font-semibold mb-4">
        Aparece en los primeros resultados
      </h3>

      <p class="text-neutral-400 leading-relaxed mb-8">
        Optimizamos tu web para que Google te muestre antes que a tu competencia
        cuando alguien busque lo que vendes en tu ciudad.
      </p>

      <div
        class="flex items-center gap-2 text-[var(--color-primary)] font-medium"
      >
        Quiero aparecer en Google
        <ArrowUpRight
          size={18}
          class="group-hover:translate-x-1 group-hover:-translate-y-1 transition"
        />
      </div>
    </a>

    <!-- CARD 3: Clientes en Maps -->
    <a
      href="/servicios"
      data-aos="fade-up"
      data-aos-delay="300"
      class="group relative overflow-hidden p-8 rounded-3xl
             bg-gradient-to-b from-neutral-900 to-neutral-950
             border border-neutral-800
             hover:border-[var(--color-primary)]
             transition duration-300
             hover:-translate-y-1
             hover:shadow-[0_0_40px_rgba(34,197,94,0.12)]"
    >
      <div
        class="mb-6 inline-flex p-4 rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
      >
        <MapPinned size={32} />
      </div>

      <h3 class="text-2xl font-semibold mb-4">
        Clientes que caminan hasta tu puerta
      </h3>

      <p class="text-neutral-400 leading-relaxed mb-8">
        Optimizo tu perfil de Google Maps para que la gente de tu zona te elija
        a ti. Más visitas al local, más ventas.
      </p>

      <div
        class="flex items-center gap-2 text-[var(--color-primary)] font-medium"
      >
        Quiero más visitas al local
        <ArrowUpRight
          size={18}
          class="group-hover:translate-x-1 group-hover:-translate-y-1 transition"
        />
      </div>
    </a>

    <!-- CARD 4: Vende con contenido -->
    <a
      href="/servicios"
      data-aos="fade-up"
      data-aos-delay="400"
      class="group relative overflow-hidden p-8 rounded-3xl
             bg-gradient-to-b from-neutral-900 to-neutral-950
             border border-neutral-800
             hover:border-[var(--color-primary)]
             transition duration-300
             hover:-translate-y-1
             hover:shadow-[0_0_40px_rgba(34,197,94,0.12)]"
    >
      <div
        class="mb-6 inline-flex p-4 rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
      >
        <FileText size={32} />
      </div>

      <h3 class="text-2xl font-semibold mb-4">
        Vende más con contenido estratégico
      </h3>

      <p class="text-neutral-400 leading-relaxed mb-8">
        Artículos y textos que responden las dudas de tus clientes ideales.
        Contenido que los educa y los convence de comprar.
      </p>

      <div
        class="flex items-center gap-2 text-[var(--color-primary)] font-medium"
      >
        Quiero contenido que venda
        <ArrowUpRight
          size={18}
          class="group-hover:translate-x-1 group-hover:-translate-y-1 transition"
        />
      </div>
    </a>
  </div>
</section>
