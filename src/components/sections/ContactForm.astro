<section id="contacto" data-aos="fade-up" class="py-28 scroll-mt-32">
  <div class="max-w-2xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-6">
      Solicita tu auditoría SEO
    </h2>

    <p class="text-neutral-400 text-center mb-12">
      Cuéntame sobre tu negocio y te diré cómo mejorar tu posicionamiento.
    </p>

    <form
      id="contact-form"
      class="space-y-6 bg-neutral-900/60 border border-neutral-800 p-8 rounded-2xl backdrop-blur"
    >
      <!-- Nombre -->
      <div>
        <label class="block text-sm mb-2 text-neutral-300"> Nombre </label>

        <input
          type="text"
          name="name"
          placeholder="Tu nombre"
          class="w-full p-3 rounded-lg bg-neutral-950 border border-neutral-800 focus:border-[var(--color-primary)] focus:outline-none"
          required
        />
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm mb-2 text-neutral-300"> Email </label>

        <input
          type="email"
          name="email"
          placeholder="tu@email.com"
          class="w-full p-3 rounded-lg bg-neutral-950 border border-neutral-800 focus:border-[var(--color-primary)] focus:outline-none"
          required
        />
      </div>

      <!-- Mensaje -->
      <div>
        <label class="block text-sm mb-2 text-neutral-300"> Mensaje </label>

        <textarea
          name="message"
          rows="4"
          placeholder="Describe tu proyecto o negocio..."
          class="w-full p-3 rounded-lg bg-neutral-950 border border-neutral-800 focus:border-[var(--color-primary)] focus:outline-none"
          required></textarea>
      </div>

      <!-- Widget invisible de Cloudflare Turnstile con la Key corregida -->
      <div
        class="cf-turnstile"
        data-sitekey="0x4AAAAAAEK0Zy40nW7JlWfA"
        data-theme="dark"
      >
      </div>

      <!-- Botón -->
      <button
        id="submit-button"
        type="submit"
        class="w-full bg-[var(--color-primary)] text-black font-semibold py-3 rounded-lg hover:opacity-90 transition"
      >
        Enviar solicitud
      </button>

      <p id="form-error" class="hidden text-red-400 text-sm text-center">
        Ocurrió un error o la verificación anti-spam falló. Intenta nuevamente.
      </p>
    </form>
  </div>
</section>

<!-- Script oficial de Cloudflare Turnstile -->
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script is:inline>
  const form = document.getElementById("contact-form");
  const button = document.getElementById("submit-button");
  const errorMessage = document.getElementById("form-error");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      button.disabled = true;
      button.textContent = "Enviando...";
      errorMessage.classList.add("hidden");

      const formData = new FormData(form);

      try {
        const response = await fetch("https://formspree.io/f/mojywkkb", {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          if (typeof window.trackEvent === "function") {
            window.trackEvent("form_submit");
          }

          window.location.href = "/gracias";
        } else {
          throw new Error("Error enviando formulario");
        }
      } catch (error) {
        console.error(error);

        button.disabled = false;
        button.textContent = "Enviar solicitud";

        errorMessage.classList.remove("hidden");

        if (window.turnstile) {
          window.turnstile.reset();
        }
      }
    });
  }
</script>
