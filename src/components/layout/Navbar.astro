---
import { Menu, X } from "@lucide/astro";
---

<nav class="sticky top-0 z-50 px-3 md:px-6 pt-3">
  <div class="max-w-7xl mx-auto">
    <!-- NAV CONTAINER -->
    <div
      class="relative flex items-center justify-between h-18 px-5 md:px-8 rounded-2xl border border-white/10 bg-black/65 backdrop-blur-xl shadow-[0_10px_40px_rgba(0,0,0,0.35)]"
    >
      <!-- LOGO -->
      <a href="/" class="shrink-0 group">
        <img
          src="/logo-ng.png"
          alt="Nelson Gabriel"
          width="220"
          height="48"
          loading="eager"
          class="h-11 md:h-12 w-auto transition duration-300 group-hover:scale-105"
        />
      </a>

      <!-- MENU DESKTOP -->
      <ul
        class="hidden md:flex items-center gap-10 text-[15px] font-medium text-neutral-300"
      >
        <li>
          <a
            href="/"
            class="relative hover:text-white transition duration-300 after:absolute after:left-0 after:-bottom-2 after:h-[2px] after:w-0 after:bg-[var(--color-primary)] after:transition-all after:duration-300 hover:after:w-full"
          >
            Inicio
          </a>
        </li>

        <li>
          <a
            href="/servicios"
            class="relative hover:text-white transition duration-300 after:absolute after:left-0 after:-bottom-2 after:h-[2px] after:w-0 after:bg-[var(--color-primary)] after:transition-all after:duration-300 hover:after:w-full"
          >
            Servicios
          </a>
        </li>

        <li>
          <a
            href="/portfolio"
            class="relative hover:text-white transition duration-300 after:absolute after:left-0 after:-bottom-2 after:h-[2px] after:w-0 after:bg-[var(--color-primary)] after:transition-all after:duration-300 hover:after:w-full"
          >
            Portfolio
          </a>
        </li>

        <li>
          <a
            href="/blog"
            class="relative hover:text-white transition duration-300 after:absolute after:left-0 after:-bottom-2 after:h-[2px] after:w-0 after:bg-[var(--color-primary)] after:transition-all after:duration-300 hover:after:w-full"
          >
            Blog
          </a>
        </li>
      </ul>

      <!-- CTA DESKTOP -->
      <a
        href="/#contacto"
        class="hidden md:inline-flex items-center justify-center bg-[var(--color-primary)] text-black px-6 py-3 rounded-xl font-semibold shadow-[0_0_20px_rgba(34,197,94,0.25)] hover:scale-105 hover:shadow-[0_0_30px_rgba(34,197,94,0.4)] active:scale-95 transition duration-300"
      >
        Auditoría Gratis
      </a>

      <!-- MOBILE BUTTON -->
      <button
        id="menuBtn"
        class="md:hidden flex items-center justify-center w-11 h-11 rounded-xl border border-white/10 bg-white/5 text-white hover:bg-white/10 transition"
      >
        <Menu id="menuIcon" size={22} />
        <X id="closeIcon" size={22} class="hidden" />
      </button>
    </div>

    <!-- MOBILE MENU -->
    <div
      id="mobileMenu"
      class="hidden mt-3 rounded-2xl border border-white/10 bg-black/90 backdrop-blur-xl overflow-hidden shadow-2xl"
    >
      <div class="flex flex-col p-5 text-neutral-200">
        <a
          href="/"
          class="py-4 border-b border-white/5 hover:text-[var(--color-primary)] transition"
        >
          Inicio
        </a>

        <a
          href="/servicios"
          class="py-4 border-b border-white/5 hover:text-[var(--color-primary)] transition"
        >
          Servicios
        </a>

        <a
          href="/portfolio"
          class="py-4 border-b border-white/5 hover:text-[var(--color-primary)] transition"
        >
          Portfolio
        </a>

        <a
          href="/blog"
          class="py-4 hover:text-[var(--color-primary)] transition"
        >
          Blog
        </a>

        <!-- CTA -->
        <a
          href="/#contacto"
          class="mt-5 bg-[var(--color-primary)] text-black py-4 rounded-xl text-center font-semibold shadow-[0_0_20px_rgba(34,197,94,0.25)]"
        >
          Solicitar Auditoría
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("menuBtn");
  const menu = document.getElementById("mobileMenu");

  const menuIcon = document.getElementById("menuIcon");
  const closeIcon = document.getElementById("closeIcon");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");

    menuIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });
</script>
