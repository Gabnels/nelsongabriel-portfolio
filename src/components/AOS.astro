---
// Componente AOS optimizado
---

<script>
  // Esperamos a que el navegador termine de cargar el contenido principal
  window.addEventListener("load", async () => {
    // Importamos dinámicamente AOS y su CSS
    // Esto evita que Astro coloque el CSS en el <head> bloqueando el renderizado
    const AOS = (await import("aos")).default;
    await import("aos/dist/aos.css");

    // Inicializamos
    AOS.init({
      duration: 800,
      once: true,
    });
  });
</script>
